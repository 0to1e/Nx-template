# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Apply to all files
[*]
indent_style = tab
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Specific overrides
[*.md]
trim_trailing_whitespace = false

[*.{js,ts,jsx,tsx}]
tab_width = 2

[Makefile]
indent_style = tab