{
  "name": "@auth-practice/backend",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@auth-practice/backend:build"
        },
        "configurations": {
          "development": {
            "buildTarget": "@auth-practice/backend:build:development",
            "args": [
              "--env-file=apps/backend/.env.development"
            ]
          },
          "production": {
            "buildTarget": "@auth-practice/backend:build:production",
            "args": [
              "--env-file=apps/backend/.env.production"
            ]
          }
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/backend/jest.config.ts",
          "passWithNoTests": true
        },
        "configurations": {
          "test": {
            "args": [
              "--env-file=apps/backend/.env.test"
            ]
          }
        }
      }
    }
  },
  "devDependencies": {
    "prettier-plugin-organize-imports": "^4.1.0"
  }
}